# cloud gateway configs

spring:
 cloud:
  gateway:
   routes:
    - id: Asset-Service-New
      uri: lb://Asset-Service-New
      predicates: 
       - Path=/assets/**
      filters:
       - StripPrefix=1
 
    - id: WorkForce-Service
      uri: lb://WorkForce-Service
      predicates:
       - Path=/wf/**
      filters:
       - StripPrefix=1

    - id: WorkOrderService
      uri: lb://WORKORDERSERVICE
      predicates:
       - Path=/workorder/** 
      filters:
       - StripPrefix=1